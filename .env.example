# Copy to .env in this folder (next to start-mac.sh). All settings are defined in backend/config.py.
# Never put real keys in this file: it is committed to git. Real keys go in .env only.

# ── Writer: set ONE (first configured wins: opencode > openai > custom > gemini). Needed to tailor resumes.
OPENCODE_API_KEY=
OPENCODE_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_PROVIDER=

# ── Job sources
REMOTE_BOARDS_ENABLED=true          # Remotive, Remote OK, We Work Remotely, Jobicy: free, no key
EXA_API_KEY=                        # career pages / ATS postings via Exa search (~$0.005 per search, 4 per scan)
APIFY_API_TOKEN=                    # LinkedIn Jobs (~$0.0015 per job, 40 per scan)
UPWORK_ACCESS_TOKEN=                # Upwork GraphQL; needs an approved API app

# ── Behaviour
SCAN_SCHEDULE_ENABLED=false         # true = scan every SCAN_INTERVAL_SECONDS on its own
SCAN_INTERVAL_SECONDS=21600
JOB_MIN_SCORE=5
AUTO_TAILOR_MIN_SCORE=              # e.g. 8.5 to auto-build kits for the best new jobs after each scan (LLM cost)
MAX_JOB_AGE_DAYS=21

# ── Optional alerts: one Telegram message per scan with the best new jobs
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_MIN_SCORE=7

# ── Server
API_TOKEN=                          # empty = no auth (local only)
DATABASE_URL=sqlite+aiosqlite:///./jobpilot.db


